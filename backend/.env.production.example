# Database — MySQL production
DATABASE_URL="mysql://user:STRONG_PASSWORD@host:3306/eduflow"

# Server
PORT=8000
NODE_ENV=production

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-string-before-deploy"
JWT_EXPIRES_IN="7d"

# CORS
FRONTEND_URL="https://your-frontend-domain.com"

# Bcrypt (12 recommended for production)
BCRYPT_ROUNDS=12

# SMTP — for forgot password emails
# Leave blank to disable (link will be logged to console instead)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="EduFlow <noreply@your-domain.com>"
