# API base URL — đổi nếu backend chạy ở port khác
VITE_API_BASE_URL=http://localhost:8000/api

# false = gọi backend thật (cần backend đang chạy)
# true  = dùng mock data trong bộ nhớ (FE chạy độc lập, không cần BE)
VITE_USE_MOCK=false

# Key để lưu JWT trong localStorage
VITE_AUTH_STORAGE_KEY=eduflow_auth
